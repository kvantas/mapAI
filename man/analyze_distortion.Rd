\deqn{\theta_a = \arctan_2\left(\frac{\partial f_y}{\partial x}\cos\alpha + \frac{\partial f_y}{\partial y}\sin\alpha,\; \frac{\partial f_x}{\partial x}\cos\alpha + \frac{\partial f_x}{\partial y}\sin\alpha\right)}
